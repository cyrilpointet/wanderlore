# Environment used by `node ace test`.
#
# Self-sufficient on purpose: `.env` is gitignored, so a fresh checkout (or a CI
# runner) has nothing to fall back on. Every variable `start/env.ts` requires is
# declared here with a test-safe value.

TZ=UTC
NODE_ENV=test
HOST=localhost
# Not 3333: the test HTTP server must not clash with a running `npm run dev`.
PORT=3334

LOG_LEVEL=silent
APP_KEY=testtesttesttesttesttesttesttest
APP_URL=http://localhost:3334

SESSION_DRIVER=memory

#--------------------------------------------------------------------
# PostgreSQL — matches the docker-compose defaults.
# The database itself is created on first boot of the volume by
# docker/postgres/init/01-create-test-database.sh
#--------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=wanderlore
PG_PASSWORD=wanderlore
PG_DB_NAME=wanderlore_test

#--------------------------------------------------------------------
# Job queue — in memory: no pg-boss in the suite, and jobs a test can
# inspect and run on demand. The worker itself never starts in tests.
#--------------------------------------------------------------------
QUEUE_DRIVER=memory

#--------------------------------------------------------------------
# Redis (unused until the job queue switches from pg-boss to BullMQ)
#--------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

#--------------------------------------------------------------------
# LLM provider
#
# Placeholder, never used: no test calls the real API. Booting the app loads
# config/llm.ts, which builds the provider eagerly — hence a value is required
# even though no request is ever sent. Live checks go through `node ace llm:ping`.
#
# Tests import `#services/llm/gateway` directly, never `#services/llm`.
#--------------------------------------------------------------------
GOOGLE_AI_API_KEY=test-key-not-used
DEFAULT_AI_MODEL=gemini-2.5-flash
