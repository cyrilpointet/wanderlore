# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Hosting on subdomains of one domain of ours (app., admin., api.)
#--------------------------------------------------------------------
# Origins of the player front and the back-office, comma-separated.
# Unused in development, where both go through the Vite proxy.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Parent domain of the session and CSRF cookies, shared by both apps.
# COOKIE_DOMAIN=.example.com
#--------------------------------------------------------------------
# PostgreSQL (see docker-compose.yml at the repo root)
#--------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=wanderlore
PG_PASSWORD=wanderlore
PG_DB_NAME=wanderlore

#--------------------------------------------------------------------
# Job queue — pg-boss, stored in PostgreSQL (schema `pgboss`)
#--------------------------------------------------------------------
# QUEUE_DRIVER=pgboss

#--------------------------------------------------------------------
# Redis (unused until the job queue switches from pg-boss to BullMQ)
#--------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

#--------------------------------------------------------------------
# LLM provider
#--------------------------------------------------------------------
GOOGLE_AI_API_KEY=
DEFAULT_AI_MODEL=gemini-3.8-flash
# LLM_REQUEST_TIMEOUT_MS=60000
