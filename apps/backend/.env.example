# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
#--------------------------------------------------------------------
# PostgreSQL (see docker-compose.yml at the repo root)
#--------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=wanderlore
PG_PASSWORD=wanderlore
PG_DB_NAME=wanderlore

#--------------------------------------------------------------------
# Redis (unused until the job queue switches from pg-boss to BullMQ)
#--------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

#--------------------------------------------------------------------
# LLM provider
#--------------------------------------------------------------------
GOOGLE_AI_API_KEY=
DEFAULT_AI_MODEL=gemini-2.5-flash
# LLM_REQUEST_TIMEOUT_MS=60000
