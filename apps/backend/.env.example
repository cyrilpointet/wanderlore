# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
#--------------------------------------------------------------------
# PostgreSQL (see docker-compose.yml at the repo root)
#--------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=wanderlore
PG_PASSWORD=wanderlore
PG_DB_NAME=wanderlore

#--------------------------------------------------------------------
# Redis (used by BullMQ from Phase 2 onwards)
#--------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
